import tkinter as tk
from tkinter import ttk, messagebox, filedialog
import threading
import os
import sys
from modules import core, settings, visual, embed

sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))

from modules import core, settings
from config import DOWNLOADS_DIR, ICON_PATH, CHANGELOG_PATH, COVER_PATH

# Версия и название билда
APP_VERSION = "0.2"
APP_BUILD_NAME = "Only Tube, but fucking good"
APP_TITLE = f"YouTube Downloader v{APP_VERSION}"


class DownloaderApp:
    def __init__(self, root):
        self.root = root
        self.settings = settings.load()
        
        self.root.title(APP_TITLE)
        self.root.geometry(self.settings.get("window_geometry", "700x760"))
        self.root.resizable(False, False)
        self.progress_var = tk.DoubleVar(value=0)
        # Обложка для MP3 (создаём при первом запуске)
        if not os.path.exists(COVER_PATH):
            try:
                visual.make_cover()
            except Exception as e:
                print(f"⚠️ Не удалось создать обложку: {e}")

        # Иконка окна
        if os.path.exists(ICON_PATH):
            try:
                self.root.iconbitmap(ICON_PATH)
            except Exception:
                pass

        # Переменные
        self.url_var = tk.StringVar()
        self.mode_var = tk.StringVar(value=self.settings.get("mode", "video"))
        self.status_var = tk.StringVar(value="Готов к работе")
        self.formats = []            # список форматов для выбора
        self.title_text = ""         # название видео
        self.downloading = False

        self._build_ui()
        self._on_mode_change()             # ← применяем при старте
        self._load_changelog()
        self.root.protocol("WM_DELETE_WINDOW", self._on_close)

    # ---------- UI ----------
    def _build_ui(self):
        pad = {'padx': 10, 'pady': 6}

        # Заголовок
        header = tk.Label(
            self.root,
            text=f"YouTube Downloader  •  v{APP_VERSION}",
            font=("Segoe UI", 14, "bold"),
        )
        header.pack(pady=(12, 2))

        build_lbl = tk.Label(
            self.root,
            text=f'"{APP_BUILD_NAME}"',
            font=("Segoe UI", 9, "italic"),
            fg="#888",
        )
        build_lbl.pack(pady=(0, 10))

        # URL
        url_frame = tk.Frame(self.root)
        url_frame.pack(fill="x", **pad)
        tk.Label(url_frame, text="URL:", font=("Segoe UI", 10)).pack(side="left")
        self.url_entry = tk.Entry(url_frame, textvariable=self.url_var, font=("Segoe UI", 10))
        self.url_entry.pack(side="left", fill="x", expand=True, padx=(8, 0))
        # Хоткеи для русской раскладки
        self.url_entry.bind("<Control-KeyPress>", self._on_ctrl_key)
        self.url_entry.bind("<Control-Insert>", lambda e: self.url_entry.event_generate("<<Paste>>"))
        # Папка сохранения
        dir_frame = tk.Frame(self.root)
        dir_frame.pack(fill="x", **pad)
        tk.Label(dir_frame, text="Папка:", font=("Segoe UI", 10)).pack(side="left")
        self.dir_label = tk.Label(
            dir_frame, text=settings.get_output_dir(self.settings),
            font=("Segoe UI", 9), fg="#333",
            anchor="w", bg="#f0f0f0", relief="flat", padx=6, pady=3,
        )
        self.dir_label.pack(side="left", fill="x", expand=True, padx=(8, 6))
        tk.Button(
            dir_frame, text="Выбрать", font=("Segoe UI", 9),
            command=self.on_choose_dir, relief="flat",
            bg="#ddd", padx=10,
        ).pack(side="left")
        
        # Настройки звука/контейнера
        opts_frame = tk.LabelFrame(self.root, text="Настройки", font=("Segoe UI", 9, "bold"))
        opts_frame.pack(fill="x", padx=10, pady=(4, 0))

        # Контейнер
        cont_row = tk.Frame(opts_frame)
        cont_row.pack(fill="x", padx=6, pady=3)
        tk.Label(cont_row, text="Контейнер:", font=("Segoe UI", 9)).pack(side="left")
        self.container_var = tk.StringVar(value=self.settings.get("container", "mp4"))

        self.rb_cont = {}                    # ← словарь для Radiobutton'ов контейнера
        for val in ("mp4", "mkv", "webm"):
            rb = tk.Radiobutton(cont_row, text=val.upper(), variable=self.container_var,
                                value=val, font=("Segoe UI", 9),
                                command=self._on_container_change)
            rb.pack(side="left", padx=(8, 0))
            self.rb_cont[val] = rb

        # Качество звука (для MP4)
        br_row = tk.Frame(opts_frame)
        br_row.pack(fill="x", padx=6, pady=3)
        tk.Label(br_row, text="Звук:", font=("Segoe UI", 9)).pack(side="left")
        self.audio_mode_var = tk.StringVar(value=self.settings.get("audio_mode", "best"))

        self.rb_audio = {}                   # ← словарь для Radiobutton'ов звука
        for val, label in [("best", "Лучший"), ("128", "128"), ("192", "192"),
                           ("256", "256"), ("320", "320"), ("none", "Без звука")]:
            rb = tk.Radiobutton(br_row, text=label, variable=self.audio_mode_var,
                                value=val, font=("Segoe UI", 9))
            rb.pack(side="left", padx=(6, 0))
            self.rb_audio[val] = rb

        # Кодек аудио
        codec_row = tk.Frame(opts_frame)
        codec_row.pack(fill="x", padx=6, pady=3)
        tk.Label(codec_row, text="Кодек аудио:", font=("Segoe UI", 9)).pack(side="left")
        self.audio_codec_var = tk.StringVar(value=self.settings.get("audio_codec", "aac"))

        self.rb_aac = tk.Radiobutton(codec_row, text="AAC", variable=self.audio_codec_var,
                                      value="aac", font=("Segoe UI", 9))
        self.rb_aac.pack(side="left", padx=(6, 0))

        self.rb_opus = tk.Radiobutton(codec_row, text="Opus", variable=self.audio_codec_var,
                                       value="opus", font=("Segoe UI", 9))
        self.rb_opus.pack(side="left", padx=(6, 0))

        self.rb_mp3 = tk.Radiobutton(codec_row, text="MP3", variable=self.audio_codec_var,
                                      value="mp3", font=("Segoe UI", 9))
        self.rb_mp3.pack(side="left", padx=(6, 0))

        # Режим
        mode_frame = tk.Frame(self.root)
        mode_frame.pack(fill="x", **pad)
        tk.Label(mode_frame, text="Режим:", font=("Segoe UI", 10)).pack(side="left")
        tk.Radiobutton(mode_frame, text="MP4 (видео)", variable=self.mode_var,
                       value="video", font=("Segoe UI", 10),
                       command=self._on_mode_change).pack(side="left", padx=(10, 0))
        tk.Radiobutton(mode_frame, text="MP3 (звук)", variable=self.mode_var,
                       value="audio", font=("Segoe UI", 10),
                       command=self._on_mode_change).pack(side="left", padx=(10, 0))
       

        # Кнопка "Получить форматы"
        self.fetch_btn = tk.Button(
            self.root, text="Получить форматы",
            command=self.on_fetch, font=("Segoe UI", 10, "bold"),
            bg="#e62117", fg="white", activebackground="#b71c1c",
            activeforeground="white", relief="flat", padx=16, pady=6,
        )
        self.fetch_btn.pack(pady=8)

        # Название видео
        self.title_label = tk.Label(self.root, text="", font=("Segoe UI", 10, "bold"),
                                    wraplength=600, justify="center")
        self.title_label.pack(pady=(4, 4))

        # Список форматов
        list_frame = tk.Frame(self.root)
        list_frame.pack(fill="both", expand=True, **pad)
        scrollbar = tk.Scrollbar(list_frame)
        scrollbar.pack(side="right", fill="y")
        self.formats_list = tk.Listbox(
            list_frame, yscrollcommand=scrollbar.set,
            font=("Consolas", 10), height=8,
            selectmode="single", activestyle="none",
        )
        self.formats_list.pack(side="left", fill="both", expand=True)
        scrollbar.config(command=self.formats_list.yview)

        # Кнопка "Скачать"
        self.download_btn = tk.Button(
            self.root, text="⬇ Скачать",
            command=self.on_download, font=("Segoe UI", 11, "bold"),
            bg="#e62117", fg="white", activebackground="#b71c1c",
            activeforeground="white", relief="flat", padx=20, pady=8,
            state="disabled",
        )
        self.download_btn.pack(pady=8)
        # Прогресс-бар
        progress_frame = tk.Frame(self.root)
        progress_frame.pack(fill="x", padx=10, pady=(4, 0))

        self.progress = ttk.Progressbar(
            progress_frame, orient="horizontal",
            mode="determinate", length=500, maximum=100,
        )
        self.progress.pack(side="left", fill="x", expand=True)

        self.progress_label = tk.Label(
            progress_frame, text="0%", font=("Segoe UI", 9, "bold"),
            width=6, anchor="e",
        )
        self.progress_label.pack(side="left", padx=(8, 0))

        # Статус
        status_lbl = tk.Label(self.root, textvariable=self.status_var,
                              font=("Segoe UI", 9), fg="#555", anchor="w")
        status_lbl.pack(fill="x", padx=10)

        # Changelog снизу
        cl_frame = tk.LabelFrame(self.root, text="Changelog", font=("Segoe UI", 9, "bold"))
        cl_frame.pack(fill="x", padx=10, pady=(6, 10))
        self.changelog_text = tk.Text(
            cl_frame, height=5, font=("Consolas", 8),
            bg="#f7f7f7", relief="flat", wrap="word",
        )
        self.changelog_text.pack(fill="x", padx=6, pady=6)
        self.changelog_text.config(state="disabled")
        # Применяем правила блокировки при старте
        self._on_container_change()
    # ---------- Changelog ----------
    def _load_changelog(self):
        text = "Changelog не найден."
        if os.path.exists(CHANGELOG_PATH):
            try:
                with open(CHANGELOG_PATH, "r", encoding="utf-8") as f:
                    text = f.read()
            except Exception as e:
                text = f"Не удалось прочитать CHANGELOG: {e}"
        else:
            text = (
                f"v{APP_VERSION} — \"{APP_BUILD_NAME}\"\n"
                "- Модульная структура\n"
                "- GUI на Tkinter\n"
                "- MP3 / MP4\n"
                "- Changelog"
            )
        self.changelog_text.config(state="normal")
        self.changelog_text.delete("1.0", "end")
        self.changelog_text.insert("1.0", text)
        self.changelog_text.config(state="disabled")

    # ---------- Логика ----------
    def set_status(self, text):
        self.status_var.set(text)
        self.root.update_idletasks()
        
    def _on_ctrl_key(self, event):                   # ← новый метод
        """Ctrl+V/X/C/A работают на любой раскладке."""
        key = event.keycode
        if key == 86:      # V — вставить
            self.url_entry.event_generate("<<Paste>>")
            return "break"
        elif key == 67:    # C — копировать
            self.url_entry.event_generate("<<Copy>>")
            return "break"
        elif key == 88:    # X — вырезать
            self.url_entry.event_generate("<<Cut>>")
            return "break"
        elif key == 65:    # A — выделить всё
            self.url_entry.select_range(0, "end")
            self.url_entry.icursor("end")
            return "break"
            
    def on_choose_dir(self):
        current = settings.get_output_dir(self.settings)
        chosen = filedialog.askdirectory(
            title="Выбери папку для сохранения",
            initialdir=current,
        )
        if chosen:
            self.settings["output_dir"] = chosen
            self.dir_label.config(text=chosen)
            settings.save(self.settings)
            self.set_status(f"Папка сохранения: {chosen}")
            
    def _on_mode_change(self):
        mode = self.mode_var.get()
        if mode == "audio":
            for rb in self.rb_cont.values():
                rb.config(state="disabled")
            self.rb_opus.config(state="normal")
            self.rb_audio["none"].config(state="disabled")
            if self.audio_mode_var.get() == "none":
                self.audio_mode_var.set("best")
        else:
            for rb in self.rb_cont.values():
                rb.config(state="normal")
            self.rb_audio["none"].config(state="normal")
            self._on_container_change()
        # НЕ очищаем список — пусть пользователь сам решает
            
    def _on_container_change(self):
        """Блокирует Opus для MP4 и переключает на AAC."""
        container = self.container_var.get()
        if container == 'mp4':
            self.rb_opus.config(state="disabled")
            if self.audio_codec_var.get() == 'opus':
                self.audio_codec_var.set('aac')
        else:
            self.rb_opus.config(state="normal")
            
    def _on_close(self):
        self.settings["mode"] = self.mode_var.get()
        self.settings["container"] = self.container_var.get()
        self.settings["audio_mode"] = self.audio_mode_var.get()
        self.settings["audio_codec"] = self.audio_codec_var.get()
        self.settings["window_geometry"] = self.root.geometry()
        settings.save(self.settings)
        self.root.destroy()

    def on_fetch(self):
        if self.downloading:
            return
        url = self.url_var.get().strip()
        if not url:
            messagebox.showwarning("URL пустой", "Вставь ссылку на видео.")
            return

        self.fetch_btn.config(state="disabled")
        self.download_btn.config(state="disabled")
        self.formats_list.delete(0, "end")
        self.title_label.config(text="")
        self.set_status("Получаю форматы...")

        threading.Thread(target=self._fetch_worker, args=(url,), daemon=True).start()

    def _fetch_worker(self, url):
        try:
            title, videos, audios = core.get_formats(url)
            self.title_text = title

            if self.mode_var.get() == "audio":
                sorted_fmts = core.unique_sorted_audio(audios)
                lines = []
                for f in sorted_fmts:
                    size_mb = f['filesize'] / (1024 * 1024) if f['filesize'] else 0
                    size_str = f"{size_mb:.1f} MB" if size_mb else "?"
                    lines.append(f"{f['abr']:.0f} kbps | {f['acodec']} | {f['ext']} | {size_str}")
            else:
                sorted_fmts = core.unique_sorted_video(videos)
                lines = []
                for f in sorted_fmts:
                    size_mb = f['filesize'] / (1024 * 1024) if f['filesize'] else 0
                    size_str = f"{size_mb:.1f} MB" if size_mb else "?"
                    lines.append(f"{f['height']}p{f['fps']} | {f['ext']} | {size_str}")

            self.formats = sorted_fmts
            self.root.after(0, self._populate_formats, title, lines)
        except Exception as e:
            self.root.after(0, self._fetch_error, str(e))

    def _populate_formats(self, title, lines):
        self.title_label.config(text=f"🎬 {title}")
        for line in lines:
            self.formats_list.insert("end", line)
        if lines:
            self.formats_list.selection_set(0)
            self.formats_list.activate(0)
        self.fetch_btn.config(state="normal")
        self.download_btn.config(state="normal")
        self.set_status(f"Найдено форматов: {len(lines)}")

    def _fetch_error(self, msg):
        self.fetch_btn.config(state="normal")
        self.set_status("Ошибка получения форматов")
        messagebox.showerror("Ошибка", msg)

    def on_download(self):
        if self.downloading:
            return
        sel = self.formats_list.curselection()
        if not sel:
            messagebox.showwarning("Формат не выбран", "Выбери формат из списка.")
            return
        url = self.url_var.get().strip()
        if not url:
            messagebox.showwarning("URL пустой", "Вставь ссылку.")
            return
        fmt = self.formats[sel[0]]

        self.downloading = True
        self.fetch_btn.config(state="disabled")
        self.download_btn.config(state="disabled")
        self.set_status("Скачиваю...")
        self._set_progress(0)

        mode = self.mode_var.get()
        threading.Thread(target=self._download_worker, args=(url, fmt, mode), daemon=True).start()
        
    def _download_worker(self, url, fmt, mode):
        try:
            core.PROGRESS_CALLBACK = self._on_progress
            output_dir = settings.get_output_dir(self.settings)

            if mode == "audio":
                codec = self.audio_codec_var.get() if self.audio_codec_var.get() in ("mp3", "m4a") else "mp3"
                bitrate = None
                am = self.audio_mode_var.get()
                if am.isdigit():
                    bitrate = int(am)
                core.download_audio(url, fmt['id'], output_dir, codec=codec, bitrate=bitrate)

                # Ищем обложку рядом с MP3
                mp3_path = embed.find_latest_mp3(output_dir)
                if mp3_path:
                    thumb = embed.find_thumbnail(mp3_path)
                    cover = thumb if thumb else (COVER_PATH if os.path.exists(COVER_PATH) else None)
                    if cover:
                        embed.embed_cover(mp3_path, cover)
                        print(f"✅ Обложка вшита: {os.path.basename(mp3_path)}")
            else:
                container = self.container_var.get()
                am = self.audio_mode_var.get()
                audio_mode = 'best'
                audio_bitrate = None
                audio_codec = None

                if am == 'none':
                    audio_mode = 'none'
                elif am.isdigit():
                    audio_mode = 'bitrate'
                    audio_bitrate = int(am)

                codec = self.audio_codec_var.get()
                if codec in ('aac', 'opus'):
                    audio_mode = 'custom'
                    audio_codec = codec

                core.download_video(url, fmt['id'], output_dir,
                                    container=container,
                                    audio_mode=audio_mode,
                                    audio_bitrate=audio_bitrate,
                                    audio_codec=audio_codec)

            core.PROGRESS_CALLBACK = None
            self.root.after(0, self._download_done)
        except Exception as e:
            core.PROGRESS_CALLBACK = None
            self.root.after(0, self._download_error, str(e))

    def _download_done(self):
        self.downloading = False
        self.fetch_btn.config(state="normal")
        self.download_btn.config(state="normal")
        output_dir = settings.get_output_dir(self.settings)               # ← берём из настроек
        self.set_status(f"✅ Готово! Файл в: {output_dir}")

        self.settings["mode"] = self.mode_var.get()
        settings.add_recent_url(self.settings, self.url_var.get().strip())
        self.settings["container"] = self.container_var.get()
        self.settings["audio_mode"] = self.audio_mode_var.get()
        self.settings["audio_codec"] = self.audio_codec_var.get()
        settings.save(self.settings)

        messagebox.showinfo("Готово", f"Файл сохранён в:\n{output_dir}")   # ← из настроек

    def _download_error(self, msg):
        self.downloading = False
        self.fetch_btn.config(state="normal")
        self.download_btn.config(state="normal")
        self.set_status("Ошибка скачивания")
        messagebox.showerror("Ошибка скачивания", msg)
    def _on_progress(self, d):
        if d.get('status') == 'downloading':
            total = d.get('total_bytes') or d.get('total_bytes_estimate')
            downloaded = d.get('downloaded_bytes', 0)
            if total:
                percent = downloaded / total * 100
                self.root.after(0, self._set_progress, percent)
        elif d.get('status') == 'finished':
            self.root.after(0, self._set_progress, 100)

    def _set_progress(self, percent):
        self.progress['value'] = percent
        self.progress_label.config(text=f"{percent:.0f}%")


def run():
    root = tk.Tk()
    DownloaderApp(root)
    root.mainloop()